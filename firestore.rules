rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de autenticação e autorização
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regras de Usuários e Perfis
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Regras de Empresas (Multi-Tenant)
    match /companies/{companyId} {
      allow read, write: if isAuthenticated();
    }

    // Coleções vinculadas à empresa (Clientes, Contatos, Agendamentos, Tarefas, WhatsApp, etc)
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    match /contacts/{contactId} {
      allow read, write: if isAuthenticated();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /whatsapp_instances/{instanceId} {
      allow read, write: if isAuthenticated();
    }

    match /whatsapp_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    match /whatsapp_quick_replies/{replyId} {
      allow read, write: if isAuthenticated();
    }

    // Fila de Espera para Encaixes
    match /appointment_waitlist/{waitlistId} {
      allow read, write: if isAuthenticated();
    }

    // Pesquisas NPS de Satisfação
    match /nps_surveys/{surveyId} {
      allow read, write: if isAuthenticated();
      allow create: if true; // Respostas via webhook/público
    }

    // Formulários de Pré-Atendimento e Anamnese
    match /pre_anamnese_forms/{formId} {
      allow read, update, delete: if isAuthenticated();
      allow create: if true; // Paciente preenche via link externo público
    }

    // Comprovantes Pix com OCR
    match /pix_receipts/{receiptId} {
      allow read, write: if isAuthenticated();
      allow create: if true; // Webhooks podem criar comprovantes detectados
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs são imutáveis
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
